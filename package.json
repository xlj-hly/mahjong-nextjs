{
  "name": "mahjong",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:tui": "turbo run dev --ui tui",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^16",
    "oxfmt": "^0.65.0",
    "turbo": "^2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxfmt"
    ],
    "*.{json,jsonc,md,yaml,yml,css}": [
      "oxfmt"
    ]
  },
  "packageManager": "pnpm@11.24.0"
}
